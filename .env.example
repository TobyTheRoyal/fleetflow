# Copy to .env and replace the placeholder with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_DB=fleetflow
POSTGRES_USER=fleetflow
POSTGRES_PORT=5433
API_PORT=5080

# Optional Workers Free AI. Keep disabled until account, model, terms, billing and fictional data are manually verified.
AI_ENABLED=false
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
AI_FREE_TIER_VERIFIED=false
AI_FREE_TIER_VERIFIED_MODEL=
AI_FREE_TIER_VERIFIED_UNTIL_UTC=
AI_USAGE_TERMS_VERIFIED=false
AI_FICTIONAL_DATA_CONFIRMED=false
AI_ALLOWED_USER_IDS=
AI_USER_DAILY_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=20
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_INPUT_BYTES=6000
