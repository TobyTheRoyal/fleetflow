# Template only. Store actual values outside Git and Docker build context.
ASPNETCORE_ENVIRONMENT=Production
SERVE_SPA=true
PORT=10000
AllowedHosts=YOUR-SERVICE.onrender.com
Deployment__PublicOrigin=https://YOUR-SERVICE.onrender.com
# Set only after confirming the actual trusted upstream proxy addresses with the host.
# No default trust, no wildcard/0.0.0.0/0, no ASPNETCORE_FORWARDEDHEADERS_ENABLED.
# Deployment__TrustedProxies__0=EXACT-VERIFIED-PROXY-IP
# Deployment__TrustedNetworks__0=VERIFIED-NARROW-CIDR
Portfolio__Enabled=true
Portfolio__ViewerSlots=10
Portfolio__DispatcherSlots=3
Portfolio__LeaseMinutes=30
Portfolio__MaxWrites=100
Portfolio__EntryPerMinute=6
ConnectionStrings__FleetFlow=Host=DIRECT-NEON-HOST;Database=YOUR_DB;Username=fleetflow_web;Password=RUNTIME_SECRET;SSL Mode=VerifyFull;Minimum Pool Size=0;Maximum Pool Size=10;Keepalive=0;GSS Encryption Mode=Disable;Timeout=15;Command Timeout=30
ConnectionStrings__PortfolioMaintenance=Host=DIRECT-NEON-HOST;Database=YOUR_DB;Username=fleetflow_maintenance;Password=MAINTENANCE_SECRET;SSL Mode=VerifyFull;Minimum Pool Size=0;Maximum Pool Size=2;Keepalive=0;GSS Encryption Mode=Disable;Timeout=15;Command Timeout=20
# External PFX supplied as a runtime secret file. .b64 also accepts base64-encoded PFX.
DataProtection__CertificatePath=/etc/secrets/fleetflow-protection.pfx.b64
DataProtection__CertificatePassword=EXTERNAL_CERTIFICATE_PASSWORD
# During rotation retain previous private keys as additional runtime secret files:
# DataProtection__PreviousCertificates__0=/etc/secrets/previous-protection.pfx.b64
AI_ENABLED=false
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
AI_FREE_TIER_VERIFIED=false
AI_FREE_TIER_VERIFIED_MODEL=
AI_FREE_TIER_VERIFIED_UNTIL_UTC=
AI_USAGE_TERMS_VERIFIED=false
AI_FICTIONAL_DATA_CONFIRMED=false
AI_ALLOWED_USER_IDS=
AI_USER_DAILY_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=20
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_INPUT_BYTES=6000
