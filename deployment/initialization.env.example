# Copy production.env.example to a PRIVATE external file and apply these overrides.
# Never install this owner connection in the web service runtime.
# Keep all Production origin/certificate settings, AI disabled and maintenance connection.
ConnectionStrings__FleetFlow=Host=DIRECT-NEON-HOST;Database=YOUR_DB;Username=DATABASE_OWNER;Password=OWNER_SECRET;SSL Mode=VerifyFull;Channel Binding=Require;Pooling=false;Minimum Pool Size=0;Maximum Pool Size=2;Keepalive=0;GSS Encryption Mode=Disable;Timeout=15;Command Timeout=60
ConnectionStrings__PortfolioRuntime=Host=DIRECT-NEON-HOST;Database=YOUR_DB;Username=fleetflow_web;Password=GENERATED_RUNTIME_SECRET_MIN_24_CHARACTERS;SSL Mode=VerifyFull;Channel Binding=Require;Minimum Pool Size=0;Maximum Pool Size=10;Keepalive=0;GSS Encryption Mode=Disable;Timeout=15;Command Timeout=30
# ConnectionStrings__PortfolioMaintenance must use a distinct login and generated password.
# Existing login passwords are never silently rotated by repeated initialization.
